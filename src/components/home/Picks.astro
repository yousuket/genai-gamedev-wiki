---
// トップページ: おすすめ記事（カテゴリの色付きカード）
import { getEntry } from 'astro:content';
import TablerIcon from '../TablerIcon.astro';
import { categoryOf, readingMinutes, withBase } from '../../data/categories';

const ids = [
	'dev-env/engines',
	'design/core-loop',
	'genres/llm-native',
	'legal/copyright',
	'monetization/wishlists',
	'trailer/steam-trailer',
];
const picks = (await Promise.all(ids.map((id) => getEntry('docs', id)))).filter((e) => e !== undefined);
---

<ul class="picks not-content">
	{
		picks.map((e) => {
			const c = categoryOf(e.id)!;
			return (
				<li>
					<a href={withBase(`/${e.id}/`)} style={`--c:${c.color};--ink:${c.ink}`}>
						<span class="cover">
							<TablerIcon name={c.icon} size="2.25rem" />
						</span>
						<span class="body">
							<span class="cat">{c.label}</span>
							<span class="title">{e.data.title}</span>
							<span class="time">
								<TablerIcon name="clock" size="1em" />約{readingMinutes(e.body)}分
							</span>
						</span>
					</a>
				</li>
			);
		})
	}
</ul>

<style>
	.picks {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.picks a {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border-radius: 24px;
		border: 2px solid color-mix(in srgb, var(--c) 35%, transparent);
		background: var(--sl-color-bg);
		color: var(--sl-color-white);
		text-decoration: none;
		transition: transform 0.15s ease, border-color 0.15s ease;
	}
	.picks a:hover {
		transform: translateY(-3px);
		border-color: var(--c);
	}
	.cover {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 5.5rem;
		background: var(--c);
		color: var(--ink);
		background-image: radial-gradient(color-mix(in srgb, #fff 22%, transparent) 2px, transparent 2px);
		background-size: 16px 16px;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.9rem 1rem 1rem;
		flex: 1;
	}
	.cat {
		font-size: var(--sl-text-xs);
		font-weight: 700;
		/* ライトモードでは暗く、ダークモードでは明るく寄せて読みやすくする */
		color: color-mix(in srgb, var(--c) 75%, var(--sl-color-white));
	}
	.title {
		font-weight: 700;
		line-height: 1.5;
	}
	.time {
		display: inline-flex;
		align-items: center;
		gap: 0.25em;
		margin-top: auto;
		padding-top: 0.4rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 60rem) {
		.picks {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 36rem) {
		.picks {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
